SIGNING_PROVIDER=software
# Prefer SIGNING_PROVIDER=software|pkcs11 (aliases: EINVOICE_SIGNING_PROVIDER,
# legacy EINVOICE_SIGNING_KEY_SOURCE=Software|Pkcs11|Csp|Auto).
# Default is software so local/CI progress is not blocked without a physical token.
# PKCS#11 path is HARDWARE_SIGNING_PENDING / UNVERIFIED until a real eSeal is confirmed.

AGENT_ENVIRONMENT=Development
ETA_BASE_URL=https://api.preprod.invoicing.eta.gov.eg
EINVOICE_API_BASE_URL=http://localhost:3001

# When SIGNING_PROVIDER=pkcs11 (token present later):
# EINVOICE_PKCS11_LIBRARY=C:\Windows\System32\eps2003csp11.dll
# EINVOICE_CERT_FILTER=Egypt Trust
# EINVOICE_CERT_ISSUER=Egypt Trust Sealing CA
# EINVOICE_CERT_THUMBPRINT=
#
# Preferred: leave these unset and let the agent auto-detect + save to
# %LocalAppData%\Einvoice.Agent\agent.config.json (PIN never stored there).
# Optional PIN remember: DPAPI file pin.dpapi (user opt-in only).
# See apps/agent/AGENT-CREDENTIALS.md

# Optional software PEM overrides (otherwise probes TestKeys/)
# EINVOICE_SOFTWARE_KEY_PEM=
# EINVOICE_SOFTWARE_CERT_PEM=

# EINVOICE_DEVICE_LABEL=Office-PC-1
# EINVOICE_POLL_INTERVAL_SECONDS=5
