<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Einvoice.Agent.Desktop</RootNamespace>
    <!-- AssemblyName must stay distinct from Einvoice.Agent library (NuGet ambiguity).
         publish-win-x64.ps1 renames the output to Einvoice.Agent.exe for distribution. -->
    <Product>eInvoice Signing Agent</Product>
    <Company>Einvoice</Company>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <!-- Optional: drop agent.ico next to this csproj and set ApplicationIcon to agent.ico -->
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\agent.ico')">agent.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Einvoice.Agent\Einvoice.Agent.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
</Project>
