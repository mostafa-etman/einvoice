<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated macOS eSeal signing diagnostic. No ProjectReference to apps/agent or the signing service. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Einvoice.MacAgentPoc</RootNamespace>
    <AssemblyName>Einvoice.MacAgentPoc</AssemblyName>
    <RollForward>LatestMinor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pkcs11Interop" Version="5.1.2" />
  </ItemGroup>
</Project>
