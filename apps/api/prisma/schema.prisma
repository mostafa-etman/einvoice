generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExchangeRateSource {
  MANUAL
}

enum ItemCodeType {
  EGS
  GS1
}

enum ItemCodeSource {
  LOCAL
  ETA
}

enum ItemCodeSyncRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum DocumentKind {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  EXPORT_INVOICE
  EXPORT_CREDIT_NOTE
  EXPORT_DEBIT_NOTE
}

enum DocumentStatus {
  DRAFT
  READY
  PENDING_SIGNATURE
  SIGNED
  SUBMITTED
  VALID
  INVALID
  CANCELLED
  REJECTED
}

/// How the document entered the system (ETA-synced rows are read-only).
enum DocumentOrigin {
  LOCAL
  FILE_IMPORT
  ETA_SYNC
}

enum SyncConflictStatus {
  OPEN
  RESOLVED
}

enum SyncConflictResolution {
  KEEP_LOCAL
  KEEP_SERVER
  MERGED
}

enum SubmissionState {
  ASSEMBLING
  SENT
  PARTIALLY_ACCEPTED
  RESOLVED
  NEEDS_ATTENTION
  /// Transient ETA DuplicateSubmission window — not an error / not FR-004d.
  WAITING_COOLDOWN
}

enum SubmissionDocumentAttemptOutcome {
  PENDING
  ACCEPTED
  REFUSED_AT_INTAKE
  VALID
  INVALID
  CANCELLED
  REJECTED
}

enum ReceivedDocumentKind {
  PURCHASE_INVOICE
  PURCHASE_RETURN
  OTHER_RECEIVED
}

enum ReceivedBuyerDecision {
  NONE
  ACCEPTED
  REJECTED
  DECLINED_CANCELATION
  NEEDS_ATTENTION
}

enum ReceivedReconciliationStatus {
  PENDING_REVIEW
  RECONCILED
  DISPUTED
}

enum ReceivedSyncTrigger {
  CRON
  MANUAL
}

enum ReceivedSyncRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ImportJobStatus {
  UPLOADED
  MAPPING
  VALIDATING
  VALIDATED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ImportRowStatus {
  VALID
  INVALID
  CREATED
  SIGN_ENQUEUED
  FAILED
}

enum ImportRunMode {
  CREATE_ONLY
  CREATE_SIGN_SUBMIT
}

enum EtaEnvironment {
  SANDBOX
  PRODUCTION
}

enum ExportJobKind {
  LOCAL
  ETA_PACKAGE
}

enum ExportJobStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

enum EtaPackageLocalStatus {
  REQUESTED
  IN_PROGRESS
  READY
  ERROR
  DELETED
  STALLED
}

enum StatusEventSource {
  system
  eta
  user
}

/// Global ETA code catalogs (seeded offline from SDK /files/; refreshable later).
enum EtaCodeCatalogKind {
  TAX_TYPE
  TAX_SUBTYPE
  UNIT_TYPE
  WEIGHT_UNIT_TYPE
  CURRENCY
  COUNTRY
  ACTIVITY_CODE
  RECEIVER_TYPE
  ITEM_CODE_TYPE
  RETURN_REASON
  DOCUMENT_TYPE
}

enum PairingCodeStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum DeviceStatus {
  PAIRED
  REVOKED
}

enum UsageMeter {
  issued
  received
  valid
  invalid
  api_calls
  storage_bytes
}

enum UsageExportFormat {
  CSV
  XLSX
}

enum UsageExportJobStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

enum SignatureJobStatus {
  PENDING
  CLAIMED
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  email               String   @unique
  passwordHash        String   @map("password_hash")
  name                String?
  isPlatformOperator  Boolean  @default(false) @map("is_platform_operator")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  impersonationsAsOperator ImpersonationSession[] @relation("ImpersonationOperator")
  impersonationsAsTarget   ImpersonationSession[] @relation("ImpersonationTarget")

  @@map("users")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Taxpayer legal / registered company name used as ETA issuer.name.
  /// Distinct from `name` (workspace label) and from branch.name (e.g. "Main").
  legalName  String? @map("legal_name")
  /// ETA issuer.type: B (Business), P (Person), F (Foreign).
  issuerType String  @default("B") @map("issuer_type")
  /// Active ETA host profile — selects preprod vs production URLs + credential slot.
  activeEtaEnvironment EtaEnvironment @default(SANDBOX) @map("active_eta_environment")
  /// Tenant branding logo in MinIO (printable invoice + settings preview).
  logoObjectKey   String?   @map("logo_object_key")
  logoContentType String?   @map("logo_content_type")
  logoByteSize    Int?      @map("logo_byte_size")
  logoUpdatedAt   DateTime? @map("logo_updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches             Branch[]
  roles                Role[]
  memberships          Membership[]
  rolePermissions      RolePermission[]
  auditLogs            AuditLog[]
  tenantCurrencies     TenantCurrency[]
  exchangeRates        ExchangeRate[]
  tenantEtaCredentials TenantEtaCredential[]
  itemCodes            ItemCode[]
  itemCodeSyncRuns     ItemCodeSyncRun[]
  documents            Document[]
  pairingCodes         PairingCode[]
  signingDevices       SigningDevice[]
  signatureJobs        SignatureJob[]
  submissions          Submission[]
  submissionDocuments  SubmissionDocument[]
  documentFilingLocks  DocumentFilingLock[]
  documentStatusEvents DocumentStatusEvent[]
  authorityNotifications AuthorityNotification[]
  documentArtifacts    DocumentArtifact[]
  submissionTriggerSettings SubmissionTriggerSetting[]
  receivedDocuments    ReceivedDocument[]
  receivedDocumentLines ReceivedDocumentLine[]
  receivedDocumentSyncRuns ReceivedDocumentSyncRun[]
  issuedDocumentSyncRuns   IssuedDocumentSyncRun[]
  importJobs           ImportJob[]
  importRowResults     ImportRowResult[]
  exportJobs           ExportJob[]
  etaPackageRequests   EtaPackageRequest[]
  syncConflicts        SyncConflict[]
  usageEvents          UsageEvent[]
  usageDailyRollups    UsageDailyRollup[]
  usageMonthlyRollups  UsageMonthlyRollup[]
  usageExportJobs      UsageExportJob[]
  tenantBackupJobs     TenantBackupJob[]
  tenantBackupSchedules TenantBackupSchedule[]
  tenantRestoreJobs    TenantRestoreJob[]
  tenantDataExportJobs TenantDataExportJob[]
  suspendedAt          DateTime? @map("suspended_at")
  suspendedReason      String?   @map("suspended_reason")
  provisionedByUserId  String?   @map("provisioned_by_user_id") @db.Uuid
  subscription         Subscription?
  quotaOverrides       QuotaOverride[]
  paymentCustomers     PaymentCustomer[]
  invoiceRefs          InvoiceRef[]
  emailOutbox          EmailOutbox[]
  impersonationSessions ImpersonationSession[]
  invoiceNumbering     TenantInvoiceNumbering?
  documentNumberSequences DocumentNumberSequence[]
  refreshSessions      RefreshSession[]
  customers            Customer[]

  @@map("tenants")
}

model Branch {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  name                String
  isDefault           Boolean  @default(false) @map("is_default")
  isActive            Boolean  @default(true) @map("is_active")
  etaBranchCode       String?  @map("eta_branch_code")
  activityCode        String?  @map("activity_code")
  defaultCurrencyCode String?  @map("default_currency_code")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  /// Issuer (seller) address — inherited by every document issued from this branch.
  addressCountry               String? @map("address_country")
  addressGovernate             String? @map("address_governate")
  addressRegionCity            String? @map("address_region_city")
  addressStreet                String? @map("address_street")
  addressBuildingNumber        String? @map("address_building_number")
  addressPostalCode            String? @map("address_postal_code")
  addressFloor                 String? @map("address_floor")
  addressRoom                  String? @map("address_room")
  addressLandmark              String? @map("address_landmark")
  addressAdditionalInformation String? @map("address_additional_information")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultCurrency       Currency?              @relation(fields: [defaultCurrencyCode], references: [code])
  tenantEtaCredentials  TenantEtaCredential[]
  documents             Document[]
  receivedDocuments     ReceivedDocument[]
  documentNumberSequences DocumentNumberSequence[]

  @@index([tenantId])
  @@map("branches")
}

enum InvoiceNumberCharset {
  NUMERIC
  ALPHANUMERIC
}

enum InvoiceNumberScope {
  TENANT
  BRANCH
  DOCUMENT_KIND
  BRANCH_AND_KIND
}

/// Per-tenant invoice (document) internalId numbering scheme.
model TenantInvoiceNumbering {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @unique @map("tenant_id") @db.Uuid
  prefix         String               @default("INV-")
  padWidth       Int                  @default(6) @map("pad_width")
  startingNumber Int                  @default(1) @map("starting_number")
  charset        InvoiceNumberCharset @default(NUMERIC)
  scope          InvoiceNumberScope   @default(TENANT)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_invoice_numbering")
}

/// Atomic sequence counters for document internalId allocation.
/// scopeKey encodes branch/kind according to TenantInvoiceNumbering.scope.
model DocumentNumberSequence {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Empty string = not scoped; otherwise branch UUID and/or DocumentKind.
  scopeKey     String   @default("") @map("scope_key")
  branchId     String?  @map("branch_id") @db.Uuid
  documentKind String?  @map("document_kind")
  lastValue    BigInt   @default(0) @map("last_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scopeKey])
  @@index([tenantId])
  @@map("document_number_sequences")
}

model Currency {
  code      String   @id
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  decimals  Int      @default(2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches         Branch[]
  tenantCurrencies TenantCurrency[]

  @@map("currencies")
}

/// One row per ETA code catalog (tax types, UOM, countries, …). Global — no RLS.
model EtaCodeCatalog {
  id           String             @id @default(uuid()) @db.Uuid
  kind         EtaCodeCatalogKind @unique
  sourceUrl    String             @map("source_url")
  sourceFile   String?            @map("source_file")
  contentHash  String             @map("content_hash")
  entryCount   Int                @default(0) @map("entry_count")
  lastSeededAt DateTime?          @map("last_seeded_at")
  lastSyncedAt DateTime?          @map("last_synced_at")
  /// seeded | synced | drift | error
  syncStatus   String             @default("seeded") @map("sync_status")
  syncNotes    String?            @map("sync_notes")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  entries EtaCodeEntry[]

  @@map("eta_code_catalogs")
}

model EtaCodeEntry {
  id         String             @id @default(uuid()) @db.Uuid
  catalogKind EtaCodeCatalogKind @map("catalog_kind")
  code       String
  nameEn     String             @map("name_en")
  nameAr     String?            @map("name_ar")
  /// e.g. tax subtype → parent tax type code
  parentCode String?            @map("parent_code")
  meta       Json?
  isActive   Boolean            @default(true) @map("is_active")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  catalog EtaCodeCatalog @relation(fields: [catalogKind], references: [kind], onDelete: Cascade)

  @@unique([catalogKind, code])
  @@index([catalogKind])
  @@index([catalogKind, parentCode])
  @@map("eta_code_entries")
}

model TenantCurrency {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  currencyCode String   @map("currency_code")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@unique([tenantId, currencyCode])
  @@index([tenantId])
  @@map("tenant_currencies")
}

model ExchangeRate {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  baseCurrencyCode  String             @map("base_currency_code")
  quoteCurrencyCode String             @map("quote_currency_code")
  rate              Decimal            @db.Decimal(18, 8)
  source            ExchangeRateSource @default(MANUAL)
  effectiveFrom     DateTime           @map("effective_from")
  effectiveTo       DateTime?          @map("effective_to")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, baseCurrencyCode, quoteCurrencyCode])
  @@map("exchange_rates")
}

model TenantEtaCredential {
  id                           String         @id @default(uuid()) @db.Uuid
  tenantId                     String         @map("tenant_id") @db.Uuid
  branchId                     String?        @map("branch_id") @db.Uuid
  /// Separate OAuth credentials for sandbox vs production hosts.
  environment                  EtaEnvironment @default(SANDBOX)
  clientId                     String         @map("client_id")
  clientSecretCiphertext       Bytes          @map("client_secret_ciphertext")
  clientSecretNonce            Bytes          @map("client_secret_nonce")
  registrationNumber           String?        @map("registration_number")
  activityCode                 String?        @map("activity_code")
  isIntermediary               Boolean        @default(false) @map("is_intermediary")
  onBehalfOfRegistrationNumber String?        @map("on_behalf_of_registration_number")
  onBehalfOfName               String?        @map("on_behalf_of_name")
  /// Last successful Test Connection against this environment's identity host.
  lastValidatedAt              DateTime?      @map("last_validated_at")
  createdAt                    DateTime       @default(now()) @map("created_at")
  updatedAt                    DateTime       @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, environment, branchId])
  @@map("tenant_eta_credentials")
}

model ItemCode {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  type           ItemCodeType
  code           String
  description    String
  isActive       Boolean        @default(true) @map("is_active")
  source         ItemCodeSource @default(LOCAL)
  lastSyncStatus String?        @map("last_sync_status")
  lastSyncAt     DateTime?      @map("last_sync_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, code])
  @@index([tenantId])
  @@map("item_codes")
}

model ItemCodeSyncRun {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  status            ItemCodeSyncRunStatus  @default(PENDING)
  startedAt         DateTime?              @map("started_at")
  finishedAt        DateTime?              @map("finished_at")
  addedCount        Int                    @default(0) @map("added_count")
  updatedCount      Int                    @default(0) @map("updated_count")
  unchangedCount    Int                    @default(0) @map("unchanged_count")
  errorsJson        Json?                  @map("errors_json")
  triggeredByUserId String?                @map("triggered_by_user_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("item_code_sync_runs")
}

/// Tenant customer directory (ETA invoice receivers) — reuse on documents without retyping.
model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// ETA receiver.type: B (Business), P (Person), F (Foreign).
  type            String
  /// Tax registration / national ID / foreign ID — maps to ETA receiver.id.
  registrationId  String   @map("registration_id")
  /// Primary name used as ETA receiver.name (usually Arabic legal name).
  name            String
  nameEn          String?  @map("name_en")
  /// ETA address object (country, governate, regionCity, street, …).
  addressJson     Json     @map("address_json")
  /// Optional internal code for the tenant's own reference.
  code            String?
  email           String?
  phone           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, registrationId])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, code])
  @@index([tenantId, isActive])
  @@map("customers")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  description String @default("")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("memberships")
}

model RefreshSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  /// Last company the user switched to on this session (JWT `tid` is derived from this).
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant Tenant?          @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  replacedBy   RefreshSession?  @relation("RefreshRotation", fields: [replacedById], references: [id])
  replaces     RefreshSession[] @relation("RefreshRotation")

  @@index([userId])
  @@index([tokenHash])
  @@index([activeTenantId])
  @@map("refresh_sessions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("audit_logs")
}

model Document {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  kind                   DocumentKind
  status                 DocumentStatus @default(DRAFT)
  /// LOCAL = created here; FILE_IMPORT = CSV/XLSX; ETA_SYNC = pulled from ETA (read-only).
  origin                 DocumentOrigin @default(LOCAL)
  branchId               String         @map("branch_id") @db.Uuid
  currencyCode           String         @map("currency_code")
  exchangeRate           String?        @map("exchange_rate")
  issueDateTime          DateTime       @map("issue_date_time")
  internalId             String         @map("internal_id")
  etaDocumentType        String         @map("eta_document_type")
  etaDocumentTypeVersion String         @map("eta_document_type_version")
  typeVersionFetchedAt   DateTime       @map("type_version_fetched_at")
  receiverType           String?        @map("receiver_type")
  receiverId             String?        @map("receiver_id")
  receiverName           String?        @map("receiver_name")
  receiverAddressJson    Json?          @map("receiver_address_json")
  issuerSnapshotJson     Json           @map("issuer_snapshot_json")
  referencesJson         Json?          @map("references_json")
  extraDiscountAmount    String         @default("0.00") @map("extra_discount_amount")
  totalSalesAmount       String         @default("0.00") @map("total_sales_amount")
  totalDiscountAmount    String         @default("0.00") @map("total_discount_amount")
  netAmount              String         @default("0.00") @map("net_amount")
  totalAmount            String         @default("0.00") @map("total_amount")
  totalItemsDiscountAmount String       @default("0.00") @map("total_items_discount_amount")
  taxTotalsJson          Json           @default("[]") @map("tax_totals_json")
  etaPayloadJson         Json           @map("eta_payload_json")
  /// Exact ETA document bytes (field order preserved) — the ONLY thing signed and submitted.
  /// jsonb cannot be used for this: it reorders object keys and invalidates the signature.
  etaPayloadText         String?        @map("eta_payload_text") @db.Text
  canonicalPreview       String?        @map("canonical_preview") @db.Text
  signaturesJson         Json?          @map("signatures_json")
  signedAt               DateTime?      @map("signed_at")
  signedByDeviceId       String?        @map("signed_by_device_id") @db.Uuid
  needsAttention         Boolean        @default(false) @map("needs_attention")
  needsAttentionReason   String?        @map("needs_attention_reason")
  etaStatus              String?        @map("eta_status")
  etaUuid                String?        @map("eta_uuid")
  etaLongId              String?        @map("eta_long_id")
  /// Which ETA host accepted / owns this document (stamped on submit/sync).
  etaEnvironment         EtaEnvironment? @map("eta_environment")
  submissionUuid         String?        @map("submission_uuid")
  etaStatusRaw           Json?          @map("eta_status_raw")
  etaStatusUpdatedAt     DateTime?      @map("eta_status_updated_at")
  /// ETA DuplicateSubmission window — blocks POST until this instant.
  /// Always scoped: it applies only to submitCooldownPayloadHash and auto-expires.
  submitCooldownUntil    DateTime?      @map("submit_cooldown_until")
  /// Canonical digest of the payload ETA flagged as duplicate. A cooldown never
  /// blocks a different document, or the same document after its bytes change.
  submitCooldownPayloadHash String?     @map("submit_cooldown_payload_hash")
  /// Mutual exclusion: only one ETA POST per document at a time.
  submitInFlight         Boolean        @default(false) @map("submit_in_flight")
  /// When the current in-flight lock was taken, so a crashed run can be recovered.
  submitInFlightSince    DateTime?      @map("submit_in_flight_since")
  submitAttemptCount     Int            @default(0) @map("submit_attempt_count")
  submitDuplicateRetryCount Int         @default(0) @map("submit_duplicate_retry_count")
  /// [{ at, outcome, httpStatus?, code?, message?, triggerSource? }]
  submitAttemptLog       Json?          @map("submit_attempt_log")
  submitPendingRetrySubmissionId String? @map("submit_pending_retry_submission_id") @db.Uuid
  importJobId            String?        @map("import_job_id") @db.Uuid
  importRowNumber        Int?           @map("import_row_number")
  /// Client offline/online create key — unique per tenant when set (010-offline-sync).
  clientIdempotencyKey   String?        @map("client_idempotency_key")
  /// Monotonic sync base for conflict detection (independent of ETA document version).
  syncRevision           Int            @default(0) @map("sync_revision")
  version                Int            @default(0)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  createdByUserId        String?        @map("created_by_user_id") @db.Uuid
  updatedByUserId        String?        @map("updated_by_user_id") @db.Uuid

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines           DocumentLine[]
  signedByDevice  SigningDevice? @relation("DocumentSignedByDevice", fields: [signedByDeviceId], references: [id], onDelete: SetNull)
  signatureJobs   SignatureJob[]
  submissionDocuments SubmissionDocument[]
  documentStatusEvents DocumentStatusEvent[]
  documentArtifacts DocumentArtifact[]
  filingLocks     DocumentFilingLock[]
  importJob       ImportJob?     @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  syncConflicts   SyncConflict[]

  @@unique([tenantId, internalId])
  @@unique([tenantId, clientIdempotencyKey])
  @@unique([tenantId, etaUuid])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, importJobId])
  @@index([tenantId, etaEnvironment])
  @@index([tenantId, origin])
  @@map("documents")
}

