model ReceivedDocument {
  id                       String                        @id @default(uuid()) @db.Uuid
  tenantId                 String                        @map("tenant_id") @db.Uuid
  documentUuid             String                        @map("document_uuid")
  etaLongId                String?                       @map("eta_long_id")
  internalId               String?                       @map("internal_id")
  etaDocumentType          String                        @map("eta_document_type")
  etaDocumentTypeVersion   String?                       @map("eta_document_type_version")
  kind                     ReceivedDocumentKind
  etaStatus                String?                       @map("eta_status")
  dateTimeIssued           DateTime?                     @map("date_time_issued")
  issuerType               String?                       @map("issuer_type")
  issuerId                 String?                       @map("issuer_id")
  issuerName               String?                       @map("issuer_name")
  issuerJson               Json?                         @map("issuer_json")
  receiverJson             Json?                         @map("receiver_json")
  currency                 String?
  totalAmount              String?                       @map("total_amount")
  netAmount                String?                       @map("net_amount")
  rawSummaryJson           Json                          @default("{}") @map("raw_summary_json")
  rawDetailsJson           Json?                         @map("raw_details_json")
  buyerDecision            ReceivedBuyerDecision         @default(NONE) @map("buyer_decision")
  buyerDecisionReason      String?                       @map("buyer_decision_reason")
  buyerDecisionAt          DateTime?                     @map("buyer_decision_at")
  buyerDecisionByUserId    String?                       @map("buyer_decision_by_user_id") @db.Uuid
  reconciliationStatus     ReceivedReconciliationStatus  @default(PENDING_REVIEW) @map("reconciliation_status")
  reconciliationNote       String?                       @map("reconciliation_note")
  purchaseOrderLinkId      String?                       @map("purchase_order_link_id") @db.Uuid
  reconciliationExternalRef String?                      @map("reconciliation_external_ref")
  branchId                 String?                       @map("branch_id") @db.Uuid
  needsAttention           Boolean                       @default(false) @map("needs_attention")
  needsAttentionReason     String?                       @map("needs_attention_reason")
  lastSyncedAt             DateTime                      @map("last_synced_at")
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @updatedAt @map("updated_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines     ReceivedDocumentLine[]
  artifacts DocumentArtifact[]

  @@unique([tenantId, documentUuid])
  @@index([tenantId])
  @@index([tenantId, dateTimeIssued])
  @@index([tenantId, kind])
  @@index([tenantId, buyerDecision])
  @@index([tenantId, reconciliationStatus])
  @@index([tenantId, branchId])
  @@map("received_documents")
