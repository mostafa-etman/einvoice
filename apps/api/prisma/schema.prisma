  createdByUserId        String?         @map("created_by_user_id") @db.Uuid
  kind                   ExportJobKind
  status                 ExportJobStatus @default(QUEUED)
  filtersJson            Json            @map("filters_json")
  formatsJson            Json            @default("[]") @map("formats_json")
  artifactObjectKeysJson Json?           @map("artifact_object_keys_json")
  expiresAt              DateTime?       @map("expires_at")
  errorSummary           String?         @map("error_summary")
  startedAt              DateTime?       @map("started_at")
  finishedAt             DateTime?       @map("finished_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etaPackageRequest EtaPackageRequest?

  @@index([tenantId, createdAt])
  @@index([tenantId, kind, status])
  @@map("export_jobs")
}

model EtaPackageRequest {
  id                         String                @id @default(uuid()) @db.Uuid
  tenantId                   String                @map("tenant_id") @db.Uuid
  exportJobId                String                @unique @map("export_job_id") @db.Uuid
  etaRequestId               String                @map("eta_request_id")
  localStatus                EtaPackageLocalStatus @default(REQUESTED) @map("local_status")
  etaStatusRaw               Int?                  @map("eta_status_raw")
  requestPayloadJson         Json                  @map("request_payload_json")
  packageObjectKey           String?               @map("package_object_key")
  packageByteSize            Int?                  @map("package_byte_size")
  lastPolledAt               DateTime?             @map("last_polled_at")
  readyAt                    DateTime?             @map("ready_at")
  errorSummary               String?               @map("error_summary")
  notificationAcceleratedAt  DateTime?             @map("notification_accelerated_at")
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exportJob ExportJob @relation(fields: [exportJobId], references: [id], onDelete: Cascade)

  @@unique([tenantId, etaRequestId])
  @@index([tenantId, localStatus])
  @@map("eta_package_requests")
}

/// Sentinel: org-level / no branch dimension on rollups & events.
/// Use NIL UUID when branch is absent so unique constraints work under PG.

model UsageEvent {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  meter              UsageMeter
  quantity           Decimal    @db.Decimal(24, 6)
  occurredAt         DateTime   @map("occurred_at")
  branchId           String?    @map("branch_id") @db.Uuid
  currencyCode       String?    @map("currency_code")
  documentId         String?    @map("document_id") @db.Uuid
  receivedDocumentId String?    @map("received_document_id") @db.Uuid
  idempotencyKey     String     @map("idempotency_key")
  metaJson           Json?      @map("meta_json")
  createdAt          DateTime   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, meter, idempotencyKey])
  @@index([tenantId, occurredAt])
  @@index([tenantId, meter, occurredAt])
  @@index([tenantId, branchId, occurredAt])
  @@map("usage_events")
}

model UsageDailyRollup {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  bucketDate   DateTime   @map("bucket_date") @db.Date
  meter        UsageMeter
  /// NIL UUID = org-level / no branch
  branchKey    String     @default("00000000-0000-0000-0000-000000000000") @map("branch_key") @db.Uuid
  /// Empty string = org-level / no currency
  currencyKey  String     @default("") @map("currency_key")
  value        Decimal    @db.Decimal(24, 6)
  eventCount   Int        @default(0) @map("event_count")
  asOf         DateTime   @map("as_of")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bucketDate, meter, branchKey, currencyKey])
  @@index([tenantId, bucketDate])
  @@index([tenantId, meter, bucketDate])
  @@map("usage_daily_rollups")
}

model UsageMonthlyRollup {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  bucketMonth  DateTime   @map("bucket_month") @db.Date
  meter        UsageMeter
  branchKey    String     @default("00000000-0000-0000-0000-000000000000") @map("branch_key") @db.Uuid
  currencyKey  String     @default("") @map("currency_key")
  value        Decimal    @db.Decimal(24, 6)
  asOf         DateTime   @map("as_of")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bucketMonth, meter, branchKey, currencyKey])
  @@index([tenantId, bucketMonth])
  @@index([tenantId, meter, bucketMonth])
  @@map("usage_monthly_rollups")
}

model UsageExportJob {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  status          UsageExportJobStatus @default(QUEUED)
  format          UsageExportFormat
  filtersJson     Json                 @map("filters_json")
  objectKey       String?              @map("object_key")
  byteSize        Int?                 @map("byte_size")
  errorSummary    String?              @map("error_summary")
  expiresAt       DateTime?            @map("expires_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("usage_export_jobs")
}

enum TenantBackupJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

enum TenantBackupTriggerSource {
  MANUAL
  SCHEDULE
}

enum TenantRestoreJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum TenantDataExportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

model TenantBackupJob {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @map("tenant_id") @db.Uuid
  status          TenantBackupJobStatus     @default(QUEUED)
  triggerSource   TenantBackupTriggerSource @default(MANUAL) @map("trigger_source")
  scheduleId      String?                   @map("schedule_id") @db.Uuid
  objectKey       String?                   @map("object_key")
  byteSize        BigInt?                   @map("byte_size")
  checksumSha256  String?                   @map("checksum_sha256")
  schemaVersion   String                    @default("1") @map("schema_version")
  errorCode       String?                   @map("error_code")
  errorMessage    String?                   @map("error_message")
  createdByUserId String?                   @map("created_by_user_id") @db.Uuid
  startedAt       DateTime?                 @map("started_at")
  completedAt     DateTime?                 @map("completed_at")
  expiresAt       DateTime?                 @map("expires_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule TenantBackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, triggerSource, createdAt])
  @@map("tenant_backup_jobs")
}

model TenantBackupSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  cronExpression String   @map("cron_expression")
  timezone       String   @default("Africa/Cairo")
  paused         Boolean  @default(false)
  nextRunAt      DateTime? @map("next_run_at")
  lastRunAt      DateTime? @map("last_run_at")
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs   TenantBackupJob[]

  @@map("tenant_backup_schedules")
}

model TenantRestoreJob {
  id                      String                 @id @default(uuid()) @db.Uuid
  tenantId                String                 @map("tenant_id") @db.Uuid
  sourceBackupJobId       String?                @map("source_backup_job_id") @db.Uuid
  sourceTenantId          String                 @map("source_tenant_id") @db.Uuid
  sourceChecksumSha256    String                 @map("source_checksum_sha256")
  sourceObjectKey         String?                @map("source_object_key")
  status                  TenantRestoreJobStatus @default(QUEUED)
  confirmationToken       String                 @map("confirmation_token")
  actorUserId             String                 @map("actor_user_id") @db.Uuid
  actorIsPlatformOperator Boolean                @default(false) @map("actor_is_platform_operator")
  ownershipCheckPassed    Boolean?               @map("ownership_check_passed")
  checksumCheckPassed     Boolean?               @map("checksum_check_passed")
  emptyOrgCheckPassed     Boolean?               @map("empty_org_check_passed")
  errorCode               String?                @map("error_code")
  errorMessage            String?                @map("error_message")
  startedAt               DateTime?              @map("started_at")
  completedAt             DateTime?              @map("completed_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("tenant_restore_jobs")
}

model TenantDataExportJob {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  status          TenantDataExportJobStatus @default(QUEUED)
  includeFiles    Boolean                  @default(false) @map("include_files")
  objectKey       String?                  @map("object_key")
  byteSize        BigInt?                  @map("byte_size")
  errorCode       String?                  @map("error_code")
  errorMessage    String?                  @map("error_message")
  createdByUserId String?                  @map("created_by_user_id") @db.Uuid
  startedAt       DateTime?                @map("started_at")
  completedAt     DateTime?                @map("completed_at")
  expiresAt       DateTime?                @map("expires_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("tenant_data_export_jobs")
}

// --- SaaS layer (013) ---

enum PlanCode {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  READ_ONLY
  SUSPENDED
  CANCELLED
}

enum ImpersonationMode {
  READ_ONLY
  WRITE
}

enum BillingProviderId {
  stripe
  local
}

enum EmailTemplate {
  onboarding_complete
  plan_change
  payment_success
  payment_failure
  past_due
  suspend
  activate
  quota_warn
  impersonation_start
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Plan {
  id              String   @id @default(uuid()) @db.Uuid
  code            PlanCode @unique
  nameEn          String   @map("name_en")
  nameAr          String   @map("name_ar")
  descriptionEn   String?  @map("description_en")
  descriptionAr   String?  @map("description_ar")
  documentQuota   Int      @map("document_quota")
  branchQuota     Int      @map("branch_quota")
  deviceQuota     Int      @map("device_quota")
  selfServe       Boolean  @default(true) @map("self_serve")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  stripePriceId   String?  @map("stripe_price_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                      String             @id @default(uuid()) @db.Uuid
  tenantId                String             @unique @map("tenant_id") @db.Uuid
  planId                  String             @map("plan_id") @db.Uuid
  status                  SubscriptionStatus @default(ACTIVE)
  graceEndsAt             DateTime?          @map("grace_ends_at")
  currentPeriodStart      DateTime?          @map("current_period_start")
  currentPeriodEnd        DateTime?          @map("current_period_end")
  cancelAtPeriodEnd       Boolean            @default(false) @map("cancel_at_period_end")
  provider                BillingProviderId? 
  providerSubscriptionId  String?            @map("provider_subscription_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status, graceEndsAt])
  @@map("subscriptions")
}

model QuotaOverride {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  documentQuota    Int?      @map("document_quota")
  branchQuota      Int?      @map("branch_quota")
  deviceQuota      Int?      @map("device_quota")
  reason           String
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("quota_overrides")
}

model PaymentCustomer {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  provider           BillingProviderId
  providerCustomerId String            @map("provider_customer_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("payment_customers")
}

model InvoiceRef {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  provider          BillingProviderId
  providerInvoiceId String            @map("provider_invoice_id")
  status            String
  amountCents       Int               @map("amount_cents")
  currency          String
  periodStart       DateTime?         @map("period_start")
  periodEnd         DateTime?         @map("period_end")
  hostedInvoiceUrl  String?           @map("hosted_invoice_url")
  createdAt         DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerInvoiceId])
  @@index([tenantId, createdAt])
  @@map("invoice_refs")
}

model BillingWebhookEvent {
  id              String            @id @default(uuid()) @db.Uuid
  provider        BillingProviderId
  providerEventId String            @map("provider_event_id")
  type            String
  payloadJson     Json              @map("payload_json")
  processedAt     DateTime?         @map("processed_at")
  outcome         String?
  createdAt       DateTime          @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@map("billing_webhook_events")
}

model ImpersonationSession {
  id                String            @id @default(uuid()) @db.Uuid
  operatorUserId    String            @map("operator_user_id") @db.Uuid
  targetUserId      String            @map("target_user_id") @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  reason            String
  mode              ImpersonationMode @default(READ_ONLY)
  breakGlassReason  String?           @map("break_glass_reason")
  expiresAt         DateTime          @map("expires_at")
  endedAt           DateTime?         @map("ended_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  operator User   @relation("ImpersonationOperator", fields: [operatorUserId], references: [id])
  target   User   @relation("ImpersonationTarget", fields: [targetUserId], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
  @@index([operatorUserId, endedAt])
  @@map("impersonation_sessions")
}

model EmailOutbox {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String?           @map("tenant_id") @db.Uuid
  template    EmailTemplate
  locale      String
  toEmail     String            @map("to_email")
  dedupeKey   String            @unique @map("dedupe_key")
  status      EmailOutboxStatus @default(PENDING)
  payloadJson Json              @map("payload_json")
  sentAt      DateTime?         @map("sent_at")
  error       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("email_outbox")
}
