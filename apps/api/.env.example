NODE_ENV=development
PORT=3001
# App runtime role (NOSUPERUSER, NOBYPASSRLS). Migrations use MIGRATE_DATABASE_URL.
DATABASE_URL=postgresql://einvoice_app:einvoice_app@localhost:5432/einvoice?schema=public
MIGRATE_DATABASE_URL=postgresql://einvoice:einvoice@localhost:5432/einvoice?schema=public
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=einvoice
# Required ETA hosts for SANDBOX (preprod defaults). Do not rely on ETA_BASE_URL alone.
ETA_IDENTITY_BASE_URL=https://id.preprod.eta.gov.eg
ETA_API_BASE_URL=https://api.preprod.invoicing.eta.gov.eg
# Production hosts (used when tenant switches activeEtaEnvironment to PRODUCTION).
ETA_PRODUCTION_IDENTITY_BASE_URL=https://id.eta.gov.eg
ETA_PRODUCTION_API_BASE_URL=https://api.invoicing.eta.gov.eg
# Legacy optional; ignored when identity+api are set
# ETA_BASE_URL=https://api.preprod.invoicing.eta.gov.eg
# Optional globals — NOT used for live tenant token calls (creds from DB / 003)
ETA_CLIENT_ID=change-me
ETA_CLIENT_SECRET=change-me
# Set to 1 only for local sandbox integration suite (skipped in default CI)
# ETA_SANDBOX_INTEGRATION=1
# Purchases received-doc sync (cron + Sync now)
PURCHASES_SYNC_ENABLED=false
PURCHASES_SYNC_USE_RECENT=true
PURCHASES_SYNC_INTERVAL_MS=900000
# Bulk import / export
IMPORT_MAX_BYTES=25000000
TENANT_LOGO_MAX_BYTES=1048576
IMPORT_MAX_ROWS=5000
EXPORT_ARTIFACT_TTL_DAYS=14
PACKAGE_POLL_INITIAL_MS=5000
PACKAGE_POLL_MAX_MS=120000
PACKAGE_STALL_HOURS=24
# Offline sync backoff (010-offline-sync). Permissions reuse documents.view / documents.manage (no new codes).
USAGE_METERING_TIMEZONE=Africa/Cairo
USAGE_ROLLUP_CRON=0 */15 * * * *
USAGE_ROLLUP_INTERVAL_MS=900000
USAGE_EXPORT_TTL_DAYS=14
SYNC_BACKOFF_INITIAL_MS=1000
SYNC_BACKOFF_MAX_MS=60000
JWT_ACCESS_SECRET=dev-access-secret-min-16-chars
JWT_ACCESS_TTL=15m
REFRESH_COOKIE_NAME=refresh_token
REFRESH_TTL_DAYS=14
# Cross-origin refresh (https://web.localhost → https://api.localhost):
# SameSite=None + Secure is required. Do NOT set COOKIE_DOMAIN=.localhost —
# Chromium often rejects Domain=.localhost and drops the Set-Cookie entirely.
# Host-only cookies on api.localhost are sent on credentialed requests to that host.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Chromium treats web.localhost ↔ api.localhost as cross-site; Partitioned (CHIPS) is required
COOKIE_PARTITIONED=true
# COOKIE_DOMAIN=          # leave unset for local (host-only); set .example.com in prod
CORS_ORIGINS=https://web.localhost,http://localhost:3000
# Base64-encoded 32-byte libsodium secretbox key (generate: openssl rand -base64 32)
SECRETS_MASTER_KEY=dGVzdC1zZWNyZXRzLW1hc3Rlci1rZXktMzJieXRlcyE=
# Distinct key for tenant backup archive encryption (base64 32 bytes)
BACKUP_ARCHIVE_MASTER_KEY=dGVzdC1iYWNrdXAtYXJjaGl2ZS1rZXktMzJieXRlcyE=
BACKUP_ARTIFACT_TTL_DAYS=30
BACKUP_SCHEDULE_TICK_MS=60000
BACKUP_RETENTION_KEEP_LAST=14
BACKUP_RETENTION_DAYS=30
# SaaS layer (013): billing / platform-admin / email
# Stripe test-mode secret + webhook signing secret (leave unset to fail loudly on checkout/webhooks)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
BILLING_PROVIDER=stripe
BILLING_GRACE_DAYS=3
BILLING_PAST_DUE_SWEEP_INTERVAL_MS=900000
IMPERSONATION_TTL_MINUTES=30
EMAIL_TRANSPORT=console
