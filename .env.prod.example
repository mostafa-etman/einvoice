############################################################
# Production environment — copy to .env.prod on the VPS.
# NEVER commit .env.prod (gitignored). Fill every CHANGE_ME.
#
# Generate secrets:
#   openssl rand -base64 48
#   openssl rand -base64 32   # for SECRETS_MASTER_KEY / BACKUP_ARCHIVE_MASTER_KEY
############################################################

# --- Domains (Traefik Host rules + public URLs) ---
WEB_HOST=eta.erp-esafe.com
API_HOST=api.eta.erp-esafe.com
ACME_EMAIL=admin@erp-esafe.com

# Web — required at Docker *build* (Next.js inlines NEXT_PUBLIC_*) AND at
# *runtime* (instrumentation.ts / loadWebEnv). Compose passes both build.args
# and web.environment from this file.
NEXT_PUBLIC_API_URL=https://api.eta.erp-esafe.com
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# --- Postgres ---
POSTGRES_USER=einvoice
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=einvoice
POSTGRES_APP_USER=einvoice_app
POSTGRES_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# Runtime app role (NOSUPERUSER, NOBYPASSRLS) — used by api/worker
DATABASE_URL=postgresql://einvoice_app:CHANGE_ME_STRONG_APP_PASSWORD@postgres:5432/einvoice?schema=public

# Migration/admin owner role — used ONLY by migrate scripts (table owner)
MIGRATE_DATABASE_URL=postgresql://einvoice:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/einvoice?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MinIO ---
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=einvoice
# Inside Docker network MinIO is plain HTTP on service name "minio"
# (compose overrides MINIO_ENDPOINT/PORT/USE_SSL for api & worker)

# --- Auth / cookies / CORS (cross-subdomain refresh) ---
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=15m
REFRESH_COOKIE_NAME=refresh_token
REFRESH_TTL_DAYS=14
COOKIE_DOMAIN=.erp-esafe.com
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Domain=.erp-esafe.com → leave Partitioned false (CHIPS + Domain is unreliable)
COOKIE_PARTITIONED=false
CORS_ORIGINS=https://eta.erp-esafe.com

# --- Encryption keys (base64 32-byte) ---
SECRETS_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
BACKUP_ARCHIVE_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_BACKUP_KEY

# --- ETA hosts ---
# Sandbox / preprod (tenant activeEtaEnvironment = SANDBOX)
ETA_IDENTITY_BASE_URL=https://id.preprod.eta.gov.eg
ETA_API_BASE_URL=https://api.preprod.invoicing.eta.gov.eg
# Production ETA hosts (when tenant switches to PRODUCTION)
ETA_PRODUCTION_IDENTITY_BASE_URL=https://id.eta.gov.eg
ETA_PRODUCTION_API_BASE_URL=https://api.invoicing.eta.gov.eg
# Optional globals — NOT used for live tenant token calls (creds live in DB)
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=

# --- Purchases sync ---
PURCHASES_SYNC_ENABLED=true
PURCHASES_SYNC_USE_RECENT=true
PURCHASES_SYNC_INTERVAL_MS=900000

# --- Import / export / sync / usage ---
IMPORT_MAX_BYTES=25000000
TENANT_LOGO_MAX_BYTES=1048576
IMPORT_MAX_ROWS=5000
EXPORT_ARTIFACT_TTL_DAYS=14
PACKAGE_POLL_INITIAL_MS=5000
PACKAGE_POLL_MAX_MS=120000
PACKAGE_STALL_HOURS=24
SYNC_BACKOFF_INITIAL_MS=1000
SYNC_BACKOFF_MAX_MS=60000
USAGE_METERING_TIMEZONE=Africa/Cairo
USAGE_ROLLUP_INTERVAL_MS=900000
USAGE_EXPORT_TTL_DAYS=14

# --- Backup ---
BACKUP_ARTIFACT_TTL_DAYS=30
BACKUP_SCHEDULE_TICK_MS=60000
BACKUP_RETENTION_KEEP_LAST=14
BACKUP_RETENTION_DAYS=30

# --- Billing / Stripe (test placeholders; swap for live when ready) ---
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
BILLING_GRACE_DAYS=3
BILLING_PAST_DUE_SWEEP_INTERVAL_MS=900000
IMPERSONATION_TTL_MINUTES=30
EMAIL_TRANSPORT=console

# --- Optional first seed (scripts/prod-seed.sh) ---
SEED_TENANT_NAME=Demo Company
SEED_BRANCH_NAME=Main
SEED_OWNER_EMAIL=owner@erp-esafe.com
SEED_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
SEED_OWNER_NAME=Owner
