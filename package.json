{
  "name": "einvoice",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:agent": "dotnet test apps/agent/Einvoice.Agent.sln",
    "build": "turbo run build",
    "build:agent": "dotnet build apps/agent/Einvoice.Agent.sln",
    "db:prepare": "pnpm --filter @einvoice/api prisma:generate && pnpm --filter @einvoice/api prisma:migrate",
    "db:seed": "pnpm --filter @einvoice/api db:seed",
    "eta:codes:seed": "pnpm --filter @einvoice/api eta:codes:seed",
    "eta:codes:refresh-sdk": "pnpm --filter @einvoice/api eta:codes:refresh-sdk",
    "dev:api": "pnpm db:prepare && turbo run dev --filter=@einvoice/shared --filter=@einvoice/api",
    "dev:web": "turbo run dev --filter=@einvoice/shared --filter=@einvoice/web",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file infra/.env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file infra/.env down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
